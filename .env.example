# Google Gemini OpenAI-compatible endpoint. Leave AI_API_KEY blank for local OCR
# and conservative rule-based extraction.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Supabase PostgreSQL connection string from Project Settings > Database.
# Use the session pooler URI if your network cannot access the direct database.
SUPABASE_DB_URL=

# Required on Vercel only: create a private Supabase Storage bucket and use
# the server-only service_role key from Supabase Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medlens-uploads

# Optional path to the Tesseract executable. If omitted, medlens checks PATH
# and the standard Windows installation directory. Install Hindi language
# data to recognize Devanagari; English OCR works with eng data alone.
TESSERACT_CMD=
# Optional plus-separated installed Tesseract language codes, e.g. eng+hin+mal.
TESSERACT_LANGS=
MAX_UPLOAD_MB=12
